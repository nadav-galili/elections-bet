# Copy to server/.env and client/.env and fill in real values.

# ───────── server/.env ─────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Local Postgres via docker-compose (see server/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elections_bet?schema=public
# Clerk → https://dashboard.clerk.com (enable Google, Apple, Email+Password)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Clerk Dashboard → Webhooks → signing secret (for user sync)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# ───────── client/.env ─────────
# Vite only exposes VITE_-prefixed vars to the browser
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_API_BASE_URL=http://localhost:4000
